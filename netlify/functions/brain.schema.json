{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theorozcorealty.com/schema/brain.schema.v1.json",
  "title": "OrozcoRealty Brain Response Schema (v1)",
  "type": "object",
  "required": ["ok", "schemaVersion", "profile", "pay", "city"],
  "properties": {
    "ok": { "type": "boolean" },

    "schemaVersion": {
      "type": "string",
      "description": "Contract version for this payload, e.g. 1.0"
    },

    "profile": { "$ref": "./profile.schema.v1.json" },

    "pay": {
      "type": "object",
      "required": ["basePay", "bas", "bah", "total"],
      "properties": {
        "basePay": { "type": "number", "minimum": 0 },
        "bas": { "type": "number", "minimum": 0 },
        "bah": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 },

        "zipUsed": { "type": ["string", "null"] },
        "familyUsed": { "type": ["boolean", "null"] },
        "rankUsed": { "type": ["string", "null"] },
        "yosUsed": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },

    "city": {
      "type": "object",
      "required": ["avg_home_value", "target_rent"],
      "properties": {
        "avg_home_value": { "type": "number", "minimum": 0 },
        "target_rent": { "type": "number", "minimum": 0 },

        "city": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },

        "bedrooms": {
          "type": "object",
          "description": "Bedroom-based market baselines from the city JSON (rent, home price, utilities). Keys are bedroom counts as strings (e.g., \"1\", \"2\", \"3\", \"4\").",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "rent_monthly": {
                "type": "object",
                "properties": {
                  "low": { "type": "number", "minimum": 0 },
                  "high": { "type": "number", "minimum": 0 },
                  "avg": { "type": "number", "minimum": 0 },
                  "as_of": { "type": ["string", "null"] }
                },
                "additionalProperties": true
              },
              "home_price": {
                "type": "object",
                "properties": {
                  "low": { "type": "number", "minimum": 0 },
                  "high": { "type": "number", "minimum": 0 },
                  "avg": { "type": "number", "minimum": 0 },
                  "as_of": { "type": ["string", "null"] }
                },
                "additionalProperties": true
              },
              "utilities": {
                "type": "object",
                "properties": {
                  "electric_gas": {
                    "type": "object",
                    "properties": {
                      "low": { "type": "number", "minimum": 0 },
                      "high": { "type": "number", "minimum": 0 },
                      "avg": { "type": "number", "minimum": 0 }
                    },
                    "additionalProperties": true
                  },
                  "water_sewer": {
                    "type": "object",
                    "properties": {
                      "low": { "type": "number", "minimum": 0 },
                      "high": { "type": "number", "minimum": 0 },
                      "avg": { "type": "number", "minimum": 0 }
                    },
                    "additionalProperties": true
                  },
                  "total": {
                    "type": "object",
                    "properties": {
                      "low": { "type": "number", "minimum": 0 },
                      "high": { "type": "number", "minimum": 0 },
                      "avg": { "type": "number", "minimum": 0 }
                    },
                    "additionalProperties": true
                  },
                  "as_of": { "type": ["string", "null"] }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },

    "errors": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "additionalProperties": true
}
