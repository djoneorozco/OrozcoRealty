{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theorozcorealty.com/schema/brain.schema.v1.2.json",
  "title": "OrozcoRealty Brain Response Schema (v1.2)",
  "type": "object",
  "required": ["ok", "schemaVersion", "profile", "pay", "city"],
  "properties": {
    "ok": { "type": "boolean" },

    "schemaVersion": {
      "type": "string",
      "description": "Contract version for this payload, e.g. 1.2"
    },

    "note": { "type": ["string", "null"] },

    "profile": { "$ref": "./profile.schema.v1.json" },

    "pay": {
      "type": "object",
      "required": ["basePay", "bas", "bah"],
      "properties": {
        "basePay": { "type": "number", "minimum": 0 },
        "bas": { "type": "number", "minimum": 0 },
        "bah": { "type": "number", "minimum": 0 },

        "total": { "type": "number", "minimum": 0 },
        "totalPay": { "type": "number", "minimum": 0 },

        "disability": { "type": "number", "minimum": 0 },
        "vaDisabilityPay": { "type": "number", "minimum": 0 },
        "retirementPay": { "type": "number", "minimum": 0 },

        "payModel": { "type": ["string", "null"] },
        "payAccuracy": { "type": ["string", "null"] },

        "zipUsed": { "type": ["string", "null"] },
        "familyUsed": { "type": ["boolean", "null"] },
        "rankUsed": { "type": ["string", "null"] },
        "yosUsed": { "type": ["number", "null"], "minimum": 0 }
      },
      "anyOf": [
        { "required": ["total"] },
        { "required": ["totalPay"] }
      ],
      "additionalProperties": true
    },

    "mortgage": {
      "type": ["object", "null"],
      "description": "Optional: breakdown of the mortgage estimate when available.",
      "properties": {
        "aprUsed": { "type": "number", "minimum": 0 },
        "termYears": { "type": "number", "minimum": 0 },
        "loanAmount": { "type": "number", "minimum": 0 },

        "principalMonthly": { "type": "number", "minimum": 0 },
        "interestMonthly": { "type": "number", "minimum": 0 },
        "taxMonthly": { "type": "number", "minimum": 0 },
        "insuranceMonthly": { "type": "number", "minimum": 0 },
        "hoaMonthly": { "type": "number", "minimum": 0 },
        "pmiMonthly": { "type": "number", "minimum": 0 },

        "principalInterestMonthly": { "type": "number", "minimum": 0 },
        "totalMonthly": { "type": "number", "minimum": 0 },

        "source": { "type": ["string", "null"], "description": "e.g., brain, local, mixed" }
      },
      "additionalProperties": true
    },

    "city": {
      "type": "object",
      "properties": {
        "city": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },

        "avg_home_value": { "type": "number", "minimum": 0 },
        "target_rent": { "type": "number", "minimum": 0 },

        "market": {
          "type": ["object", "null"],
          "properties": {
            "avg_home_value": { "type": "number", "minimum": 0 },
            "target_rent": { "type": "number", "minimum": 0 },

            "average_home_value": { "type": "number", "minimum": 0 },
            "avgHome": { "type": "number", "minimum": 0 },
            "city_avg_home": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": true
        },

        "bedrooms": {
          "type": ["object", "null"],
          "description": "Bedroom-based market baselines from the city JSON. Keys are bedroom counts as strings.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "rent_monthly": {
                "type": ["object", "null"],
                "properties": {
                  "low": { "type": "number", "minimum": 0 },
                  "high": { "type": "number", "minimum": 0 },
                  "avg": { "type": "number", "minimum": 0 },
                  "as_of": { "type": ["string", "null"] }
                },
                "additionalProperties": true
              },
              "home_price": {
                "type": ["object", "null"],
                "properties": {
                  "low": { "type": "number", "minimum": 0 },
                  "high": { "type": "number", "minimum": 0 },
                  "avg": { "type": "number", "minimum": 0 },
                  "as_of": { "type": ["string", "null"] }
                },
                "additionalProperties": true
              },
              "utilities": {
                "type": ["object", "null"],
                "properties": {
                  "electric_gas": {
                    "type": ["object", "null"],
                    "properties": {
                      "low": { "type": "number", "minimum": 0 },
                      "high": { "type": "number", "minimum": 0 },
                      "avg": { "type": "number", "minimum": 0 }
                    },
                    "additionalProperties": true
                  },
                  "water_sewer": {
                    "type": ["object", "null"],
                    "properties": {
                      "low": { "type": "number", "minimum": 0 },
                      "high": { "type": "number", "minimum": 0 },
                      "avg": { "type": "number", "minimum": 0 }
                    },
                    "additionalProperties": true
                  },
                  "total": {
                    "type": ["object", "null"],
                    "properties": {
                      "low": { "type": "number", "minimum": 0 },
                      "high": { "type": "number", "minimum": 0 },
                      "avg": { "type": "number", "minimum": 0 }
                    },
                    "additionalProperties": true
                  },
                  "as_of": { "type": ["string", "null"] }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        }
      },
      "anyOf": [
        { "required": ["avg_home_value", "target_rent"] },
        { "required": ["market"] }
      ],
      "additionalProperties": true
    },

    "missing": { "type": ["array", "null"], "items": { "type": "string" } },

    "errors": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "additionalProperties": true
}
