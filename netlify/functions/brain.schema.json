{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theorozcorealty.com/schema/brain.schema.v1.2.json",
  "title": "OrozcoRealty Brain Response Schema (v1.2)",
  "type": "object",
  "required": ["ok", "schemaVersion"],
  "properties": {
    "ok": { "type": "boolean" },

    "schemaVersion": {
      "type": "string",
      "description": "Contract version for this payload, e.g. 1.2"
    },

    "input": {
      "type": "object",
      "required": ["email", "cityKey", "bedrooms"],
      "properties": {
        "email": { "type": "string", "minLength": 3 },
        "cityKey": { "type": "string", "minLength": 1 },
        "bedrooms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },

    "debug": {
      "type": "object",
      "description": "Optional debug surface (safe for UI/dev).",
      "properties": {
        "payTablesPathUsed": { "type": ["string", "null"] },
        "cityKeyRaw": { "type": ["string", "null"] },
        "cityKeyResolved": { "type": ["string", "null"] },
        "cityKeySource": { "type": ["string", "null"] },
        "baseUsedForCity": { "type": ["string", "null"] },
        "cityLoadFallbackUsed": { "type": ["boolean", "null"] },
        "cityLoadError": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },

    "profile": { "$ref": "./profile.schema.v1.json" },
    "profileEffective": { "$ref": "./profile.schema.v1.json" },

    "overridesApplied": {
      "type": ["object", "null"],
      "description": "Subset of overrides that were accepted and applied (not persisted).",
      "additionalProperties": true
    },

    "pay": {
      "type": "object",
      "description": "Computed pay object. Shape varies slightly by payModel.",
      "required": ["basePay", "total"],
      "properties": {
        "payModel": { "type": ["string", "null"] },
        "payAccuracy": { "type": ["string", "null"] },

        "basePay": { "type": "number", "minimum": 0 },
        "bas": { "type": "number", "minimum": 0 },
        "bah": { "type": "number", "minimum": 0 },

        "retirementPay": { "type": "number", "minimum": 0 },
        "vaDisabilityPay": { "type": "number", "minimum": 0 },

        "totalPay": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 },

        "debug": { "type": ["object", "null"], "additionalProperties": true }
      },
      "additionalProperties": true
    },

    "city": {
      "type": "object",
      "description": "City JSON (normalized).",
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },

        "avg_home_value": { "type": ["number", "null"], "minimum": 0 },
        "average_home_value": { "type": ["number", "null"], "minimum": 0 },
        "avgHome": { "type": ["number", "null"], "minimum": 0 },
        "city_avg_home": { "type": ["number", "null"], "minimum": 0 },

        "target_rent": { "type": ["number", "null"], "minimum": 0 },
        "targetRent": { "type": ["number", "null"], "minimum": 0 },

        "avg_utilities": { "type": ["number", "null"], "minimum": 0 },
        "average_utilities": { "type": ["number", "null"], "minimum": 0 },
        "avgUtilities": { "type": ["number", "null"], "minimum": 0 },

        "market": { "type": ["object", "null"], "additionalProperties": true },
        "targets": { "type": ["object", "null"], "additionalProperties": true },

        "bedrooms": {
          "type": ["object", "null"],
          "description": "Bedroom-based baselines from the city JSON. Keys are bedroom counts as strings.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "rent_monthly": {
                "type": ["object", "null"],
                "properties": {
                  "low": { "type": ["number", "null"], "minimum": 0 },
                  "high": { "type": ["number", "null"], "minimum": 0 },
                  "avg": { "type": ["number", "null"], "minimum": 0 },
                  "as_of": { "type": ["string", "null"] }
                },
                "additionalProperties": true
              },
              "home_price": {
                "type": ["object", "null"],
                "properties": {
                  "low": { "type": ["number", "null"], "minimum": 0 },
                  "high": { "type": ["number", "null"], "minimum": 0 },
                  "avg": { "type": ["number", "null"], "minimum": 0 },
                  "as_of": { "type": ["string", "null"] }
                },
                "additionalProperties": true
              },
              "utilities": {
                "type": ["object", "null"],
                "properties": {
                  "electric_gas": {
                    "type": ["object", "null"],
                    "properties": {
                      "low": { "type": ["number", "null"], "minimum": 0 },
                      "high": { "type": ["number", "null"], "minimum": 0 },
                      "avg": { "type": ["number", "null"], "minimum": 0 }
                    },
                    "additionalProperties": true
                  },
                  "water_sewer": {
                    "type": ["object", "null"],
                    "properties": {
                      "low": { "type": ["number", "null"], "minimum": 0 },
                      "high": { "type": ["number", "null"], "minimum": 0 },
                      "avg": { "type": ["number", "null"], "minimum": 0 }
                    },
                    "additionalProperties": true
                  },
                  "total": {
                    "type": ["object", "null"],
                    "properties": {
                      "low": { "type": ["number", "null"], "minimum": 0 },
                      "high": { "type": ["number", "null"], "minimum": 0 },
                      "avg": { "type": ["number", "null"], "minimum": 0 }
                    },
                    "additionalProperties": true
                  },
                  "as_of": { "type": ["string", "null"] }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },

    "missing": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },

    "mortgage": {
      "type": "object",
      "required": ["ok", "breakdown", "assumptions", "sources"],
      "properties": {
        "ok": { "type": "boolean" },
        "breakdown": {
          "type": "object",
          "required": ["principalInterest", "propertyTax", "insurance", "hoa", "pmi", "totalMonthly"],
          "properties": {
            "principalInterest": { "type": "number", "minimum": 0 },
            "propertyTax": { "type": "number", "minimum": 0 },
            "insurance": { "type": "number", "minimum": 0 },
            "hoa": { "type": "number", "minimum": 0 },
            "pmi": { "type": "number", "minimum": 0 },
            "totalMonthly": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "assumptions": {
          "type": "object",
          "description": "Inputs/assumptions used in mortgage computation. May include note when price is missing.",
          "properties": {
            "note": { "type": ["string", "null"] },
            "price": { "type": ["number", "null"], "minimum": 0 },
            "dpPct": { "type": ["number", "null"], "minimum": 0 },
            "dpAmt": { "type": ["number", "null"], "minimum": 0 },
            "loan": { "type": ["number", "null"], "minimum": 0 },
            "apr": { "type": ["number", "null"], "minimum": 0 },
            "termYears": { "type": ["integer", "null"], "minimum": 0 },
            "taxRate": { "type": ["number", "null"], "minimum": 0 },
            "insRate": { "type": ["number", "null"], "minimum": 0 },
            "hoa": { "type": ["number", "null"], "minimum": 0 },
            "pmiRate": { "type": ["number", "null"], "minimum": 0 },
            "loanType": { "type": ["string", "null"] },
            "creditScore": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": true
        },
        "sources": {
          "type": "object",
          "description": "Source trace for each mortgage assumption (body/profile/city/default).",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    },

    "estimatedMonthlyMortgage": { "type": "number", "minimum": 0 },

    "error": {
      "type": ["string", "null"],
      "description": "Present when ok=false due to server failure or invalid request."
    },

    "errors": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "additionalProperties": true
}
